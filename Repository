FROM public.ecr.aws/lambda/provided:al2023

WORKDIR /usr/src

# Instala ferramentas base, python3 e pip
RUN dnf update -y && \
    dnf install -y wget nano git tar telnet python3 python3-pip && \
    dnf clean all

# Instala o AWS CLI usando pip
RUN pip3 install awscli --upgrade

# Instala o Go v1.24
WORKDIR /usr/local

RUN wget https://go.dev/dl/go1.24.2.linux-amd64.tar.gz && \
    tar -vzxf go1.24.2.linux-amd64.tar.gz && \
    rm -rf go1.24.2.linux-amd64.tar.gz

# Define as variáveis de ambiente GOROOT e PATH
ENV GOROOT=/usr/local/go
ENV PATH="$GOROOT/bin:${PATH}"

# Define a variável de ambiente GO111MODULE para habilitar módulos Go (opcional, mas recomendado)
ENV GO111MODULE=on

# Define o diretório de trabalho
WORKDIR /app

CMD ["/bin/bash"]